# RDI application environment
APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost/rdi
APP_TIMEZONE=Asia/Dhaka

# MySQL
RDI_DB_HOST=localhost
RDI_DB_PORT=3306
RDI_DB_NAME=rdi_portal
RDI_DB_USER=root
RDI_DB_PASS=
RDI_DB_CHARSET=utf8mb4

# Research news AI enrichment (optional; research import works without a key)
RDI_NEWS_AI_PROVIDER=none
RDI_GEMINI_API_KEY=
RDI_GEMINI_MODEL=gemini-2.5-flash
RDI_DEEPSEEK_API_KEY=
RDI_DEEPSEEK_MODEL=deepseek-v4-flash
RDI_NEWS_HTTP_TIMEOUT=25
RDI_PUBLIC_FEED_INSECURE_SSL_FALLBACK=true

# SMTP placeholders for Phase 5
RDI_SMTP_HOST=
RDI_SMTP_PORT=587
RDI_SMTP_USER=
RDI_SMTP_PASS=
RDI_SMTP_ENCRYPTION=tls
RDI_SMTP_FROM_EMAIL=
RDI_SMTP_FROM_NAME=RDI Innovators

# Local seed accounts (change/remove for production)
RDI_SEED_ADMIN_EMAIL=admin@rdi.local
RDI_SEED_ADMIN_PASSWORD=change-this-admin-password
RDI_SEED_RESEARCHER_EMAIL=researcher@rdi.local
RDI_SEED_RESEARCHER_PASSWORD=change-this-researcher-password
RDI_SEED_DEMO_ACCOUNTS=true
